# /etc/superwitness/env: mode 0640, owner root:superwitness. Every setting is described at
# https://docs.superwitness.dev/use/configuration/
SW_LISTEN=127.0.0.1:8790
SW_PUBLIC_URL=https://superwitness.example.internal
# Runtime role: SELECT and INSERT on verdicts and rubrics, SELECT, INSERT and UPDATE on runs; never the table owner (README "Two database roles").
SW_DATABASE_URL=postgres://superwitness_app:<password>@127.0.0.1:5432/superwitness?sslmode=disable
# Owner role, used only for migrations (serve's background migrations and `superwitness migrate`).
SW_MIGRATE_DATABASE_URL=postgres://superwitness_owner:<password>@127.0.0.1:5432/superwitness?sslmode=disable
SW_SUPERPIPELINE_URL=https://app.superpipeline.dev
SW_HUB_URL=https://hub.agentpod.dev
# The svc_ id of an AgentPod service principal with scope evidence:read, as printed by AgentPod's
# fleet CLI: fleet principals add-service superwitness --client superwitness --scope evidence:read
SW_HUB_CLIENT_ID=svc_REPLACE_ME
SW_HUB_CLIENT_SECRET_FILE=/etc/superwitness/hub-client-secret
# The organization plane. Setting the issuer switches every token path to it; the two hub
# credential lines above are then unused. Each comes from the plane's operator.
# SW_ORG_PLANE_ISSUER=https://accounts.example
# SW_ORG_PLANE_JWKS_URL=https://accounts.example/api/auth/jwks
# SW_ORG_PLANE_URL=https://accounts.example
# SW_ORG_PLANE_SERVICE_CREDENTIAL_FILE=/etc/superwitness/org-plane-service-credential
SW_TRACES_URL=http://127.0.0.1:10428
SW_LOGS_URL=http://127.0.0.1:9428
# SW_TRACES_TOKEN_FILE=/etc/superwitness/traces-token
# SW_LOGS_TOKEN_FILE=/etc/superwitness/logs-token
SW_SOURCE_TIMEOUT=2s
# Run reporters: each service principal (prn_…) that may POST /v1/runs, bound to the one source
# it reports for. Its token must carry the runs:write scope. Unset: nobody may report.
# SW_RUN_SOURCES=prn_REPLACE_ME=superpipeline
# Browser sign-in. Off while SW_ALLOWED_PRINCIPALS is empty. SW_PUBLIC_URL must then be https.
# SW_APP_CLIENT_ID=superwitness-console
# SW_ALLOWED_PRINCIPALS=prn_REPLACE_ME
# 32+ random bytes, mode 0600: head -c 48 /dev/urandom | base64 > /etc/superwitness/session-secret
# SW_SESSION_SECRET_FILE=/etc/superwitness/session-secret
# Who may set CF-Connecting-IP; unset means this host's own addresses.
# SW_TRUSTED_PROXIES=127.0.0.1
# Where superwitness sends its own traces and metrics; optional.
# SW_OTLP_ENDPOINT=http://127.0.0.1:4318
