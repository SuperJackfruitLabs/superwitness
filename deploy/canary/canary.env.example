# Copy to /etc/superwitness/canary.env on the superwitness host (mode 0644, root).
# This file holds NO secret. The client secret is the separate 0600 file named below.
# Do not set SWC_EXPECT_HARNESS here: the first live run overrides it from the environment to prove
# a failure reaches your alert channel.

# superpipeline. The token is accepted here only if the superwitness-canary hub client's
# audience list (deploy-time HUB_OAUTH_CLIENTS) includes this URL as well as SW_PUBLIC_URL.
SW_SUPERPIPELINE_URL=https://app.superpipeline.dev

# superwitness on this host. The MCP endpoint is this URL + /mcp.
SWC_SUPERWITNESS_URL=http://127.0.0.1:8790

# The AgentPod hub and the canary's own service credential: the svc_ id printed
# by `fleet principals add-service superwitness-canary --client superwitness-canary --scope evidence:read`, and the file holding its secret alone.
SW_HUB_URL=https://hub.agentpod.dev
SWC_HUB_CLIENT_ID=
SWC_HUB_CLIENT_SECRET_FILE=/etc/superwitness/canary-client-secret

# The local collector's OTLP/HTTP logs endpoint, where flow 8's one synthetic error line goes.
# This is the default; set it only to override.
SWC_OTLP_LOGS_URL=http://127.0.0.1:4318/v1/logs

# Engines on this host. Token files are optional.
SW_TRACES_URL=http://127.0.0.1:10428
SW_LOGS_URL=http://127.0.0.1:9428
SW_TRACES_TOKEN_FILE=
SW_LOGS_TOKEN_FILE=

# The superpipeline board the canary runs its cards on.
SWC_BOARD_ID=
