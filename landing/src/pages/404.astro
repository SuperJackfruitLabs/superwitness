---
// Not found.
//
// The site is a Cloudflare Worker with static assets (landing/wrangler.jsonc), configured with
// `assets.not_found_handling: "404-page"`. That setting serves this page, built to
// dist/404.html, with a real 404 status for any path that has no file. Without a 404.html
// there is nothing to serve, and a missing path either gets the platform's bare error or —
// if the handling were "single-page-application" — the home page with a 200, which tells a
// crawler that /anything is a real page with the home page's content, and tells a person who
// mistyped nothing at all.
//
// Same tokens and faces as index.astro (kept in step by hand; the two pages share no
// layout on purpose), nothing more.
import Mark from '../components/Mark.astro';
import ShareMeta from '../components/ShareMeta.astro';

const DOCS = 'https://docs.superwitness.dev';
const title = 'Not found — superwitness';
const description = 'There is no page at this address.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0e1116" />
    <ShareMeta title={title} description={description} canonical={false} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,500&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <style>
      :root {
        --bg: #0e1116; --text: #e8ecf2; --muted: #8b95a5; --jade: #3fd0a2; --jade-text: #3fd0a2;
        --display: 'Fraunces', Georgia, serif; --sans: 'IBM Plex Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
        color-scheme: dark light;
      }
      @media (prefers-color-scheme: light) {
        :root { --bg: #f7f8f6; --text: #12161c; --muted: #545e6b; --jade: #1b7f63; --jade-text: #136049; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: var(--sans); font-size: 17px; line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      main { max-width: 64ch; margin: 0 auto; padding: 96px 24px; }
      .mark { color: var(--jade); display: block; margin-bottom: 28px; }
      .code { font-family: var(--mono); font-size: 13px; letter-spacing: .12em; color: var(--muted); margin: 0 0 8px; }
      h1 {
        font-family: var(--display); font-weight: 600; font-size: clamp(34px, 6vw, 48px);
        letter-spacing: -0.025em; line-height: 1.08; margin: 0 0 12px;
      }
      p { color: var(--muted); margin: 0 0 26px; }
      nav { display: flex; gap: 20px; flex-wrap: wrap; }
      nav a { color: var(--jade-text); font-weight: 500; text-underline-offset: 3px; }
      a:focus-visible { outline: 2px solid var(--jade); outline-offset: 3px; border-radius: 4px; }
    </style>
  </head>
  <body>
    <main>
      <span class="mark"><Mark size={64} /></span>
      <p class="code">404</p>
      <h1>Nothing here</h1>
      <p>There is no page at this address; it may have moved, or the link may be mistyped.</p>
      <nav>
        <a href="/">superwitness home</a>
        <a href={DOCS}>Documentation</a>
      </nav>
    </main>
  </body>
</html>
