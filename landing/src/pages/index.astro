---
/**
 * superwitness.dev — the public page.
 *
 * One page, no framework; the suite frame owns the header, footer and theme toggle. Its job is to explain the product to somebody who
 * typed the domain, and then send them to the docs or the source. There is no app to sign
 * in to: superwitness is self-hosted, so the page sells nothing it cannot hand over.
 *
 * This directory is deliberately outside the Go module and has its own npm lockfile:
 * Astro 7 brings Vite 8, and nothing here should share a dependency tree with the
 * service's own `web/` build. `go build ./...` never looks in here.
 *
 * Every label in the hero is real.
 * The hero is a RunDocument, `GET /v1/runs/superpipeline/{board}/{run}`
 * (internal/join/document.go). Every label below is a field name or value it returns:
 *   title         run.ref "superpipeline:{board}/{run}" (source and run id) · run.stage "draft"
 *   agent         the run.agent row; its content is attempts[].fingerprint.harness ·
 *                 harness_version · digest (run.agent itself is a principal id, which
 *                 the page does not print)
 *   attempts      attempts[] (count) · attempts[].state "completed"
 *   trace         trace.status "joined" · sum of attempts[].span_count
 *   errors        errors[] (count)
 *   cost          cost.status "unreported"   (reported | unreported | unknown)
 *   verdicts      verdicts[].kind "gate", value.decision "approved", judge_kind "human"
 *                 (internal/join/join.go gateViews; judge kind from the principal lookup);
 *                 verdicts[].kind "grader", value.score 0.8 (internal/verdicts/validate.go)
 *   sources       sources map: superpipeline, agentpod, traces, logs, errors, verdicts → "ok"
 *                 (internal/source/source.go names; verdicts is the store's own key)
 * The waterfall's "configuration" row names attempts[].fingerprint's fields: harness, model,
 * profile, skill_release, digest. The MCP tool names are read from internal/mcp/server.go.
 * If any of these change, this page is wrong.
 *
 * Colours and faces are listed once, in `:root` below; docs-site/src/styles/theme.css uses
 * the same values. Jade is spent on three things only: "on the record", a joined trace and
 * an approved gate — the parts of the page that are evidence.
 */
import ShareMeta from '../components/ShareMeta.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const SITE = 'https://superwitness.dev';
const DOCS = 'https://docs.superwitness.dev';
const REPO = 'https://github.com/SuperJackfruitLabs/superwitness';
// The one hand-typed version on this page: the latest release tag. Bump with each release.
const VERSION = 'v0.0.8';
const TITLE = 'SuperWitness — every run, on the record';
const DESCRIPTION =
  'Self-hosted run evidence for agent work: a SuperPipeline run, its AgentPod attempts, spans, logs and verdicts joined into one document. MIT.';

// Structured data for search and agents; every value is one the page already states.
const JSON_LD = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SuperWitness',
  description: DESCRIPTION,
  url: SITE,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS',
  softwareVersion: VERSION,
  sameAs: [REPO],
  publisher: { '@type': 'Organization', name: 'Super Jackfruit Labs', url: 'https://superjackfruit.com' },
};

// The MCP tool list is read from the server that registers the tools, at build time, so
// this page cannot name a tool the code does not have, or miss one it does. The build
// runs in landing/, so the Go source is one directory up.
const mcpSource = readFileSync(resolve(process.cwd(), '../internal/mcp/server.go'), 'utf8');
const tools = [...mcpSource.matchAll(/sdk\.AddTool\(s,\s*&sdk\.Tool\{Name:\s*"([a-z_]+)"/g)].map((m) => m[1]);
if (tools.length === 0) throw new Error('landing: found no MCP tools in internal/mcp/server.go');

// The waterfall: one run.id across products. Offsets and widths are percentages of
// the run's duration, illustrative.
const lanes = [
  { name: 'superpipeline', depth: 0, from: 0, width: 30, tone: 'marigold' },
  { name: 'hub · dispatch', depth: 0, from: 4, width: 92, tone: 'cyan' },
  { name: 'attempt', depth: 1, from: 12, width: 70, tone: 'cyan' },
  { name: 'turn · tool', depth: 2, from: 20, width: 38, tone: 'cyan' },
  { name: 'node-agent', depth: 0, from: 16, width: 55, tone: 'grey' },
  { name: 'gate · review', depth: 0, from: 84, width: 14, tone: 'jade' },
];

const ROUTE = 'GET /v1/runs/superpipeline/{board}/{run}';

// Must match the docs site's install page ("Quick install of the binary").
const INSTALL = `curl -fsSL ${REPO}/releases/latest/download/install.sh | bash`;
const FIRST = [
  "SW_FAKE_SOURCES=1 SW_DATABASE_URL='postgres://<user>:<password>@127.0.0.1:5432/<database>?sslmode=disable' superwitness serve",
  "curl -H 'Authorization: Bearer dev:prn_human01:human' localhost:8790/v1/runs/superpipeline/brd_01/run_01",
];
import SuiteHead from '@superjackfruit/frontdoor/components/SuiteHead.astro';
import Frame from '@superjackfruit/frontdoor/components/Frame.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="theme-color" content="#0e1116" />
    <SuiteHead product="superwitness" />
    <ShareMeta title={TITLE} description={DESCRIPTION} />
    <script type="application/ld+json" set:html={JSON.stringify(JSON_LD)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,500&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <style>
      /* Contrast (WCAG 2.x), measured on the grounds they sit on:
           dark   jade #3fd0a2 on #0e1116 9.7:1 · on the jade pill 6.7:1 · muted #8b95a5 5.8:1 on surface
                  button text #0e1116 on #3fd0a2 9.7:1 · warn #f4a526 on its pill 6.5:1
           light  jade #1b7f63 on #f7f8f6 4.6:1 (headline, links) · jade-text #136049 on the jade
                  pill 6.4:1 and on inset 6.6:1 · button text #ffffff on #1b7f63 4.9:1
                  muted #545e6b 6.2:1 · warn #8a5a06 on its pill 5.2:1
         Light-theme jade is the deep jade because #3fd0a2 on a light ground is 1.9:1. */
      :root {
        --bg: #0e1116; --surface: #151a22; --inset: #070a0e; --line: rgba(255,255,255,.08);
        --text: #e8ecf2; --muted: #8b95a5; --jade: #3fd0a2; --jade-deep: #1b7f63;
        --jade-tint: rgba(63,208,162,.15); --warn: #f4a526; --warn-tint: rgba(244,165,38,.15);
        --jade-text: #3fd0a2; --jade-ink: #0e1116; --code: #c9d1dc;
        --marigold: #f4a526; --cyan: #5fb3d4; --grey: #9aa6b8;
        --display: 'Fraunces', Georgia, serif; --sans: 'IBM Plex Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
        color-scheme: dark light;
      }
      /* Light tokens: chosen by the toggle (data-theme="light"), or by the system when the
         visitor has not chosen. */
      :root[data-theme='light'] {
        --bg: #f7f8f6; --surface: #ffffff; --inset: #eef1ee; --line: rgba(14,17,22,.1);
        --text: #12161c; --muted: #545e6b; --jade: #1b7f63; --jade-deep: #136049;
        --jade-tint: rgba(27,127,99,.12); --warn: #8a5a06; --warn-tint: rgba(244,165,38,.18);
        --jade-text: #136049; --jade-ink: #ffffff; --code: #2a313b;
        --marigold: #e0961c; --cyan: #3f97bb; --grey: #8a96a8;
        color-scheme: light;
      }
      :root[data-theme='dark'] { color-scheme: dark; }
      @media (prefers-color-scheme: light) {
        :root:not([data-theme='dark']) {
          --bg: #f7f8f6; --surface: #ffffff; --inset: #eef1ee; --line: rgba(14,17,22,.1);
          --text: #12161c; --muted: #545e6b; --jade: #1b7f63; --jade-deep: #136049;
          --jade-tint: rgba(27,127,99,.12); --warn: #8a5a06; --warn-tint: rgba(244,165,38,.18);
          --jade-text: #136049; --jade-ink: #ffffff; --code: #2a313b;
          --marigold: #e0961c; --cyan: #3f97bb; --grey: #8a96a8;
          color-scheme: light;
        }
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--bg); color: var(--text);
        font-family: var(--sans); font-size: 17px; line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      a:focus-visible { outline: 2px solid var(--jade); outline-offset: 3px; border-radius: 4px; }
      .mono { font-family: var(--mono); }
      .muted { color: var(--muted); }

      .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 24px; }

      .example { font-family: var(--mono); font-size: 12px; color: var(--muted); margin: 10px 0 0; text-align: right; position: relative; z-index: 1; }
      .steps { counter-reset: step; }
      .cell .step { font-family: var(--mono); font-size: 13px; color: var(--jade-text); }
      .prose p { margin: 0 0 14px; max-width: 680px; }
      .prose p:last-child { margin-bottom: 0; }
      .tools { max-width: 680px; display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
      .tools li { font-family: var(--mono); font-size: 12.5px; padding: 3px 9px; border-radius: 6px; background: var(--inset); }
      h3.small { font-family: var(--display); font-weight: 600; font-size: 1.15rem; margin: 30px 0 10px; }
      pre + p, .install p { margin: 12px 0 0; color: var(--muted); font-size: 15.5px; max-width: 680px; }
      .install pre { max-width: 760px; }
      ul.facts.limits { grid-auto-flow: row !important; max-width: 680px; }

      /* ── hero ─────────────────────────────────────────────────── */
      .hero .wrap {
        display: grid; grid-template-columns: minmax(0, 1fr) 500px; gap: 56px; align-items: center;
        min-height: calc(100svh - 108px); padding-top: 56px; padding-bottom: 72px;
      }
      .hero .wrap > * { min-width: 0; }
      h1 {
        font-family: var(--display); font-weight: 600;
        font-size: clamp(40px, 4.6vw, 60px); line-height: 1.04;
        letter-spacing: -0.02em; margin: 0; max-width: 12ch; text-wrap: balance;
        font-variation-settings: 'opsz' 144;
      }
      h1 em { font-style: italic; font-weight: 500; color: var(--jade); }
      .lede { color: var(--muted); font-family: var(--sans); font-size: 18px; line-height: 1.55; margin: 20px 0 28px; max-width: 34em; }

      .cta { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn {
        display: inline-flex; align-items: center; border-radius: 10px;
        height: 46px; padding: 0 20px; font: 600 15px var(--sans); text-decoration: none;
        border: 1px solid transparent; transition: filter .15s, border-color .15s;
      }
      .btn-primary { background: var(--jade); color: var(--jade-ink); }
      .btn-primary:hover { filter: brightness(1.08); }
      .btn-ghost { background: transparent; border-color: var(--line); color: var(--text); }
      .btn-ghost:hover { border-color: var(--jade); }

      /* ── the run document: this page's signature ──────────────── */
      .hero { overflow-x: clip; }
      .doc-wrap { position: relative; margin: 0; }
      .doc-wrap::before {
        /* a faint jade glow under the record, nothing more */
        content: ''; position: absolute; inset: -40px -30px; z-index: 0; pointer-events: none;
        background: radial-gradient(closest-side, var(--jade-tint), transparent 75%);
        opacity: .55;
      }
      .doc {
        position: relative; z-index: 1; background: var(--surface);
        border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
        box-shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 24px 48px -24px rgba(0,0,0,.45);
        font-size: 14px;
      }
      :root[data-theme='light'] .doc { box-shadow: 0 24px 48px -28px rgba(14,17,22,.22); }
      @media (prefers-color-scheme: light) {
        :root:not([data-theme='dark']) .doc { box-shadow: 0 24px 48px -28px rgba(14,17,22,.22); }
      }
      .doc-head {
        display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap;
        gap: 4px 12px; padding: 15px 18px 13px; border-bottom: 1px solid var(--line);
      }
      .ttl { font-family: var(--display); font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
      .ttl .muted { font-family: var(--mono); font-size: 12.5px; font-weight: 400; letter-spacing: 0; margin-left: 6px; }
      .doc-head .route { font-family: var(--mono); font-size: 11px; color: var(--muted); }
      .doc dl { margin: 0; padding: 4px 18px; }
      .row {
        display: flex; align-items: center; justify-content: space-between; gap: 6px 14px;
        flex-wrap: wrap; padding: 10px 0; border-bottom: 1px dashed var(--line);
      }
      .row:last-child { border-bottom: 0; }
      .row dt { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
      .row dd { margin: 0; text-align: right; display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
      .row dd.mono { font-size: 12.5px; display: block; }
      .pill {
        font-family: var(--mono); font-size: 12px; padding: 2px 8px; border-radius: 6px;
        background: var(--inset); color: var(--text); white-space: nowrap;
      }
      .pill.jade { background: var(--jade-tint); color: var(--jade-text); }
      .pill.warn { background: var(--warn-tint); color: var(--warn); }
      .sources {
        margin: 0; padding: 11px 18px 13px; border-top: 1px solid var(--line);
        background: var(--inset); font-size: 11.5px; color: var(--muted); line-height: 1.7;
      }
      .sources b { font-weight: 500; color: var(--jade-text); }

      /* ── bands ────────────────────────────────────────────────── */
      section.band { border-top: 1px solid var(--line); }
      section.band .wrap { padding-top: 88px; padding-bottom: 88px; }
      .n {
        display: block; font-family: var(--mono); font-size: 12px; letter-spacing: .12em;
        color: var(--muted); margin-bottom: 10px;
      }
      h2 {
        font-family: var(--display); font-weight: 600;
        font-size: clamp(28px, 3vw, 36px); line-height: 1.15; letter-spacing: -0.02em;
        margin: 0 0 12px; text-wrap: balance; font-variation-settings: 'opsz' 72;
      }
      .sub, .install p.sub { color: var(--muted); margin: 0 0 32px; max-width: 640px; font-size: 17px; line-height: 1.6; }

      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 32px; }
      .cell { min-width: 0; }
      .cell h3 {
        font-family: var(--display); font-weight: 600; font-size: 18px;
        letter-spacing: -0.01em; margin: 10px 0 6px;
      }
      .cell p { margin: 0; color: var(--muted); font-size: 15.5px; }
      .cell .field {
        margin-top: auto; padding-top: 12px; font-family: var(--mono); font-size: 12px;
        color: var(--muted); border-top: 1px dashed var(--line);
      }

      /* waterfall */
      .fall {
        margin: 32px 0 0; background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
        padding: 18px 18px 14px;
      }
      .lane { display: grid; grid-template-columns: 130px 1fr; gap: 12px; align-items: center; height: 26px; }
      .lane .lname { font-family: var(--mono); font-size: 12px; color: var(--muted); white-space: nowrap; }
      .lane[data-depth='1'] .lname { padding-left: 12px; }
      .lane[data-depth='2'] .lname { padding-left: 24px; }
      .track { position: relative; height: 10px; }
      .track::before { content: ''; position: absolute; inset: 4px 0; background: var(--line); border-radius: 1px; }
      .bar { position: absolute; top: 0; height: 10px; border-radius: 3px; }
      .bar.marigold { background: var(--marigold); }
      .bar.cyan { background: var(--cyan); }
      .bar.grey { background: var(--grey); }
      .bar.jade { background: var(--jade); box-shadow: 0 0 0 3px var(--jade-tint); }
      .fall figcaption {
        margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--line);
        font-family: var(--mono); font-size: 12px; color: var(--muted);
      }
      .fall figcaption b { font-weight: 500; color: var(--text); }

      /* code */
      pre, .codeline {
        font-family: var(--mono); font-size: 13px; line-height: 1.75; color: var(--code);
        background: var(--inset); border: 1px solid var(--line); border-radius: 10px;
        margin: 0; padding: 14px 16px; overflow-x: auto; max-width: 100%;
      }
      .codeline { display: block; margin-top: 22px; word-spacing: .1em; }
      pre .p { color: var(--muted); user-select: none; }

      .install { margin-top: 30px; }
      ul.facts { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; }
      ul.facts li { position: relative; padding-left: 22px; }
      ul.facts li::before {
        content: ''; position: absolute; left: 2px; top: .62em; width: 8px; height: 8px;
        border: 1.5px solid var(--jade); border-radius: 50%;
      }
      ul.facts code, .cell code, .sub code, .prose code { font-family: var(--mono); font-size: .86em; }
      .closing { margin: 22px 0 0; font-family: var(--display); font-style: italic; font-weight: 500; font-size: 1.2rem; }
      .more { display: inline-block; margin-top: 14px; font-size: 15px; color: var(--jade-text); text-decoration: none; font-weight: 500; }
      .more:hover { text-decoration: underline; text-underline-offset: 3px; }


      @media (min-width: 900px) {
        ul.facts { grid-auto-flow: column; justify-content: start; gap: 10px 36px; }
      }
      @media (max-width: 899px) {
        .hero .wrap { grid-template-columns: 1fr; gap: 44px; min-height: auto; padding-top: 40px; padding-bottom: 56px; }
        section.band .wrap { padding-top: 64px; padding-bottom: 64px; }
        .grid { grid-template-columns: 1fr; }
      }
      @media (max-width: 480px) {
        .wrap { padding: 0 24px; }
        .lane { grid-template-columns: 104px 1fr; gap: 8px; }
        .lane .lname { font-size: 11px; }
        .doc dl, .doc-head, .sources { padding-left: 14px; padding-right: 14px; }
      }
      /* Hero moment: .doc.playing is set by the inline script below for one ~2.6s pass. */
      .doc.playing dd { opacity: 0; animation: sw-fill 320ms ease-out forwards; animation-delay: calc(var(--i, 0) * 220ms); }
      .doc.playing .verdict dd { animation: sw-stamp 380ms cubic-bezier(.2,.8,.3,1) forwards; animation-delay: 1700ms; }
      @keyframes sw-fill { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
      @keyframes sw-stamp { from { opacity: 0; transform: scale(1.15); } to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <Frame product="superwitness" cta={{ label: 'Get started', href: 'https://docs.superwitness.dev/install/' }}>
    <main>
      <section class="hero">
        <div class="wrap">
          <div>
            <h1>Every run, <em>on the record</em>.</h1>
            <p class="lede">
              SuperWitness is a self-hosted service that joins a SuperPipeline run, its AgentPod
              attempts, traces, logs and verdicts into one document: what your agents did, how your
              products behaved, and whether the work was good.
            </p>
            <div class="cta">
              <a class="btn btn-primary" href={`${DOCS}/install/`}>Get started</a>
              <a class="btn btn-ghost" href={DOCS}>Docs</a>
            </div>
          </div>

          <figure class="doc-wrap" aria-label="An example run document">
            <div class="doc">
              <div class="doc-head">
                <div class="ttl">run_7f3a <span class="muted mono">superpipeline · draft</span></div>
                <span class="route">GET /v1/runs/superpipeline/brd_01/run_7f3a</span>
              </div>
              <dl>
                <div class="row"><dt>agent</dt><dd class="mono">hermes 0.9 · <span class="muted">sha256:4dd8…</span></dd></div>
                <div class="row"><dt>attempts</dt><dd><span class="pill">2 · completed</span></dd></div>
                <div class="row"><dt>trace</dt><dd><span class="pill jade">joined · <span data-count="41">41</span> spans</span></dd></div>
                <div class="row"><dt>errors</dt><dd><span class="pill">0</span></dd></div>
                <div class="row"><dt>cost</dt><dd><span class="pill warn">unreported</span></dd></div>
                <div class="row verdict"><dt>verdicts</dt><dd><span class="pill jade">gate: approved · human</span> <span class="pill">grader 0.8</span></dd></div>
              </dl>
              <p class="sources mono">sources: superpipeline <b>ok</b> · agentpod <b>ok</b> · traces <b>ok</b> · logs <b>ok</b> · errors <b>ok</b> · verdicts <b>ok</b></p>
            </div>
            <figcaption class="example">Example run document. The fields are real; the values are made up.</figcaption>
          </figure>
        </div>
      </section>

      <section class="band" aria-labelledby="how">
        <div class="wrap">
          <h2 id="how">How it works</h2>
          <div class="grid steps">
            <div class="cell">
              <span class="step">1</span>
              <h3>Products send OTLP</h3>
              <p>
                SuperPipeline and AgentPod send plain OpenTelemetry to a Collector, which writes it
                to VictoriaTraces and VictoriaLogs. SuperWitness only queries them. Nothing waits on it.
              </p>
            </div>
            <div class="cell">
              <span class="step">2</span>
              <h3>Ask for a run</h3>
              <p>
                <code>{ROUTE}</code> joins the run, its
                attempts with the configuration that ran them, spans, logs and errors when you read
                it. A source that is down reads <code>unknown</code>, never 0.
              </p>
            </div>
            <div class="cell">
              <span class="step">3</span>
              <h3>Record a verdict</h3>
              <p>
                A person, a gate or a grader records a verdict. Verdicts are append-only in
                SuperWitness's own Postgres: a correction is a new verdict. An agent cannot judge a
                run it executed.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="band" aria-labelledby="use">
        <div class="wrap">
          <div class="prose">
            <h2 id="use">What it's like to use</h2>
            <p>
              Say an agent finished a draft on a SuperPipeline board overnight. In the morning you
              open the SuperWitness app and pick the run from <b>Needs verdict</b>. The trace shows
              where the time went across the products. Click a tool call and you see what the agent
              sent and what came back, read live from AgentPod and never stored by SuperWitness.
              You record a verdict against a rubric, and it stays on the run.
            </p>
            <p>
              An agent can do the same over MCP, with a bearer token, on the private side of your
              deployment. The tools the server registers:
            </p>
            <ul class="tools" aria-label="MCP tools">
              {tools.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <figure class="fall" aria-label="An illustrative trace waterfall: SuperPipeline, hub dispatch, attempt, turn and tool, node-agent, and the gate review, all sharing one run id">
            {lanes.map((l) => (
              <div class="lane" data-depth={l.depth}>
                <span class="lname">{l.name}</span>
                <span class="track"><span class={`bar ${l.tone}`} style={`left:${l.from}%;width:${l.width}%`}></span></span>
              </div>
            ))}
            <figcaption><b>run.id</b> = run_7f3a · illustrative</figcaption>
          </figure>
        </div>
      </section>

      <section class="band" aria-labelledby="run">
        <div class="wrap install">
          <h2 id="run">Run it yourself</h2>
          <p class="sub">
            The latest release is <a href={`${REPO}/releases/tag/${VERSION}`}>{VERSION}</a>, for
            Linux and macOS on amd64 and arm64. The installer checks the download against
            <code>SHA256SUMS</code> and puts <code>superwitness</code> and its short alias
            <code>suwi</code> in <code>~/.local/bin</code>. It installs no service and starts nothing.
          </p>
          <pre aria-label="Install"><code><span class="p">$ </span>{INSTALL}{'\n'}</code></pre>

          <h3 class="small">First command</h3>
          <pre aria-label="Try it with built-in fixtures"><code>{FIRST.map((line) => (<><span class="p">$ </span>{line}{'\n'}</>))}</code></pre>
          <p>
            Fake mode serves one development run from built-in fixtures, listens on loopback only,
            and needs nothing but a Postgres database. It is for looking around, not for real runs.
          </p>
          <p>
            A real deployment is one Linux host with systemd running SuperWitness next to Postgres,
            VictoriaTraces, VictoriaLogs and the OpenTelemetry Collector, reading runs from your
            SuperPipeline and attempts from your AgentPod hub with a service credential.
            The <a href={`${DOCS}/install/`}>install guide</a> walks through it.
          </p>
        </div>
      </section>

      <section class="band" aria-labelledby="today">
        <div class="wrap">
          <h2 id="today">Where it runs today</h2>
          <ul class="facts limits">
            <li>It is not standalone yet. It reads runs from SuperPipeline and attempts from AgentPod, and only SuperPipeline runs can be looked up. Working with other agent stacks is a goal, not this release.</li>
            <li>It stores verdicts and grader scores; it does not run graders, evaluations or calibration, and it does not compare configurations yet.</li>
            <li>Verdicts are append-only, so the service cannot rewrite them. Keeping them is your Postgres backups' job.</li>
            <li>No Windows build, no container image and no hosted service. The web app stays off until you allow people to sign in with AgentPod.</li>
          </ul>
        </div>
      </section>
    </main>
    </Frame>

    <script is:inline>
      (() => {
        const doc = document.querySelector('.doc');
        if (!doc || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const dds = doc.querySelectorAll('dd');
        dds.forEach((d, i) => d.style.setProperty('--i', i));
        const n = doc.querySelector('[data-count]');
        const play = () => {
          doc.classList.add('playing');
          if (n) {
            const end = +n.dataset.count, t0 = performance.now() + 2 * 220, dur = 700;
            n.textContent = '0';
            const tick = (t) => {
              const k = Math.min(1, Math.max(0, (t - t0) / dur));
              n.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
              if (k < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
          setTimeout(() => { doc.classList.remove('playing'); if (n) n.textContent = n.dataset.count; }, 2600);
        };
        const io = new IntersectionObserver((es) => {
          if (es.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(play, 600); }
        });
        io.observe(doc);
      })();
    </script>
  </body>
</html>
