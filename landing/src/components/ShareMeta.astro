---
/**
 * Canonical URL, icon, and the tags a link preview is built from.
 *
 * One component rather than a block per page, because the two pages here share no
 * layout — each carries its own head and styles on purpose — and link-preview tags
 * copied twice are tags that drift two ways.
 *
 * The canonical URL is derived from `Astro.site` and the page's own path, so it cannot
 * name a page that is not the one being served. og:image is absolute because several
 * unfurlers ignore a relative one. A page that is not a real address (the 404, served at
 * whatever path was mistyped) passes `canonical={false}`, which drops the canonical link and
 * og:url rather than naming the mistyped path as canonical. The image is public/og.png, 1200×630, rendered from
 * og/og.html — see og/README.md.
 */
interface Props {
  title: string;
  description: string;
  canonical?: boolean;
}

const { title, description, canonical: hasCanonical = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/og.png', Astro.site).href;
const imageAlt = 'superwitness — every run, on the record';
---

{hasCanonical && <link rel="canonical" href={canonical} />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="superwitness" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{hasCanonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
